# WOVI — copy this file to `.env` and fill in the keys you have.
#   cp .env.example .env
# Every key is optional. A source without its key shows a "KEY" tag and is
# skipped; all other sources keep working. Restart the server after a change.
# Keys stay on your machine: the server uses them, the browser never sees them.

# --- Server ------------------------------------------------------------------
# Port of the local server (it listens on 127.0.0.1 only). Default: 5173
PORT=5173

# --- Needed for these sources ------------------------------------------------
# Flickr Commons + Flickr (open licences) — https://www.flickr.com/services/apps/create/
FLICKR_KEY=

# DPLA — request a key by e-mail:
#   curl -X POST https://api.dp.la/v2/api_key/you@example.com
DPLA_KEY=

# New York Public Library — https://api.repo.nypl.org/
NYPL_TOKEN=

# Harvard Art Museums — https://harvardartmuseums.org/collections/api
HARVARD_KEY=

# Trove (National Library of Australia) — https://trove.nla.gov.au → Profile → API
TROVE_KEY=

# Pixabay — https://pixabay.com/api/docs/
PIXABAY_KEY=

# Pexels — https://www.pexels.com/api/
PEXELS_KEY=

# Unsplash — the "Access Key" from https://unsplash.com/developers
UNSPLASH_KEY=

# --- Optional: these sources work without a key ------------------------------
# Europeana — uses the shared demo key "api2demo" when empty.
# Personal key: https://pro.europeana.eu/page/get-api
EUROPEANA_KEY=

# Smithsonian Open Access — uses "DEMO_KEY" when empty (about 30 requests/hour).
# Personal key: https://api.data.gov/signup/
SMITHSONIAN_KEY=

# DigitalNZ — works without a key today; asks for one on HTTP 401/403.
# https://digitalnz.org/developers
DIGITALNZ_KEY=
